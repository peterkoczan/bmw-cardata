.venv/
__pycache__/
*.pyc
config.toml
# tokens.json* not tokens.json: save() writes tokens.json.tmp before renaming,
# and a crash inside that window leaves a live two-week refresh token behind
# that the exact-name pattern would not have caught. This repo is public.
tokens.json*
*.tmp
data/
# data_dir is configurable, so telemetry can land outside data/.
*.jsonl
